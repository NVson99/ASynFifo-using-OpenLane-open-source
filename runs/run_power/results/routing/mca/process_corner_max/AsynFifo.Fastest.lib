library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("7.10368,7.10729,7.11649,7.13931,7.20476,7.42030,8.13238");
	}
	rise_transition(template_1) {
          values("0.01878,0.02127,0.02869,0.05351,0.14450,0.45861,1.50685");
	}
	cell_fall(template_1) {
          values("6.18576,6.18877,6.19674,6.21537,6.26087,6.39621,6.84462");
	}
	fall_transition(template_1) {
          values("0.01560,0.01779,0.02361,0.03913,0.08890,0.26571,0.86353");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0037;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0065;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0058;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0768;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0061;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.52815");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17744");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0056;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.03073");
	}
	fall_constraint(scalar) {
          values("0.00876");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.37763");
	}
	fall_constraint(scalar) {
          values("0.27931");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
      capacitance : 0.0000;
    pin("r_data[7]") {
      direction : output;
      capacitance : 0.0010;
    }
