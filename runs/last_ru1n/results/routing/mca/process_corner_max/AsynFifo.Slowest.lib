library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0018;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.00519,6.01491,6.04199,6.10947,6.31010,7.02044,9.57526");
	}
	rise_transition(template_1) {
          values("0.04578,0.05224,0.07283,0.14186,0.40698,1.40523,4.99820");
	}
	cell_fall(template_1) {
          values("5.24418,5.25141,5.27361,5.32958,5.48599,6.02181,7.95285");
	}
	fall_transition(template_1) {
          values("0.03444,0.03977,0.05704,0.10979,0.30115,1.02130,3.64679");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0032;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0026;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0284;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0038;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.27291");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.53075");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0031;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.60969");
	}
	fall_constraint(scalar) {
          values("-0.54087");
	}
      }
