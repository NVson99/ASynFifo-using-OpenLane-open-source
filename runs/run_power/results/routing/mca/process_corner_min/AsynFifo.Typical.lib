library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.84225,6.84671,6.85828,6.88597,6.95916,7.18241,7.89279");
	}
	rise_transition(template_1) {
          values("0.02397,0.02721,0.03672,0.06561,0.16205,0.48198,1.50524");
	}
	cell_fall(template_1) {
          values("5.95625,5.96023,5.97067,5.99375,6.04770,6.20020,6.68059");
	}
	fall_transition(template_1) {
          values("0.02071,0.02320,0.03050,0.04990,0.10889,0.30674,0.94785");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0035;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0062;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0057;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0668;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.77680");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.30191");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0055;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.10932");
	}
	fall_constraint(scalar) {
          values("-0.02378");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.65397");
	}
	fall_constraint(scalar) {
          values("0.46628");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
      capacitance : 0.0000;
    pin("r_data[7]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("r_data[6]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[5]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("r_data[4]") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("r_data[3]") {
      direction : output;
      capacitance : 0.0015;
    }
    pin("r_data[2]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0006;
    }
    }
    bus("w_data") {
      bus_type : w_data;
      direction : input;
      capacitance : 0.0000;
    pin("w_data[7]") {
