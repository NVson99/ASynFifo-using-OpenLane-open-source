library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.98657,6.99576,7.02158,7.08813,7.28877,7.99699,10.55127");
	}
	rise_transition(template_1) {
          values("0.04115,0.04766,0.06856,0.13928,0.40694,1.40445,4.99931");
	}
	cell_fall(template_1) {
          values("6.07714,6.08392,6.10608,6.16201,6.31845,6.85406,8.79011");
	}
	fall_transition(template_1) {
          values("0.03455,0.03982,0.05717,0.10988,0.30123,1.02170,3.65176");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0036;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0063;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0057;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0717;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.50821");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.60652");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0055;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.31239");
	}
	fall_constraint(scalar) {
          values("-0.13357");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.48795");
	}
	fall_constraint(scalar) {
          values("1.10209");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
