	}
      }
    }
    pin("w_data[0]") {
      direction : input;
      capacitance : 0.0057;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02317");
	}
	fall_constraint(scalar) {
