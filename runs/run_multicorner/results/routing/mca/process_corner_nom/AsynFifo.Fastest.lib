library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.98703,6.99061,6.99976,7.02252,7.08795,7.30352,8.01554");
	}
	rise_transition(template_1) {
          values("0.01862,0.02110,0.02850,0.05338,0.14447,0.45861,1.50703");
	}
	cell_fall(template_1) {
          values("6.07744,6.08045,6.08842,6.10705,6.15256,6.28791,6.73623");
	}
	fall_transition(template_1) {
          values("0.01558,0.01778,0.02359,0.03912,0.08889,0.26572,0.86355");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0036;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0064;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0058;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0717;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0060;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.51213");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17661");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0056;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.03683");
	}
	fall_constraint(scalar) {
          values("0.00469");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.37812");
	}
	fall_constraint(scalar) {
          values("0.27781");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
      capacitance : 0.0000;
    pin("r_data[7]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("r_data[6]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[5]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[4]") {
      direction : output;
      capacitance : 0.0013;
    }
    pin("r_data[3]") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("r_data[2]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0006;
    }
    }
    bus("w_data") {
      bus_type : w_data;
      direction : input;
      capacitance : 0.0000;
    pin("w_data[7]") {
      direction : input;
      capacitance : 0.0079;
