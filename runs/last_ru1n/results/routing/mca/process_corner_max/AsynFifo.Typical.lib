      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.04317");
	}
	fall_constraint(scalar) {
          values("-0.08928");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.02625");
	}
	fall_constraint(scalar) {
          values("0.19293");
	}
      }
    }
    pin("w_data[2]") {
      direction : input;
      capacitance : 0.0037;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.00629");
	}
	fall_constraint(scalar) {
          values("-0.12212");
	}
      }
      timing() {
        related_pin : "w_clk";
