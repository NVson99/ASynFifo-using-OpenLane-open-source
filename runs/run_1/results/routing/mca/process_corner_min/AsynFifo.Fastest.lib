library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.82562,6.82915,6.83816,6.86076,6.92615,7.14178,7.85363");
	}
	rise_transition(template_1) {
          values("0.01821,0.02063,0.02802,0.05307,0.14441,0.45863,1.50748");
	}
	cell_fall(template_1) {
          values("6.22562,6.22863,6.23660,6.25524,6.30076,6.43611,6.88427");
	}
	fall_transition(template_1) {
          values("0.01556,0.01776,0.02354,0.03911,0.08886,0.26574,0.86357");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0035;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0055;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0049;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0671;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.51253");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.21751");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.05938");
	}
	fall_constraint(scalar) {
          values("-0.03282");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.38884");
	}
	fall_constraint(scalar) {
          values("0.30292");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
