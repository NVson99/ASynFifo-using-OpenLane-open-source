	rise_constraint(scalar) {
          values("0.02133");
	}
	fall_constraint(scalar) {
          values("0.09587");
	}
      }
    }
    pin("w_data[6]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02160");
	}
	fall_constraint(scalar) {
          values("-0.03208");
	}
      }
      timing() {
        related_pin : "w_clk";
