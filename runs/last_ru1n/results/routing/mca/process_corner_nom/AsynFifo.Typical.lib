	rise_constraint(scalar) {
          values("0.00667");
	}
	fall_constraint(scalar) {
          values("-0.12250");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.05368");
	}
	fall_constraint(scalar) {
          values("0.21660");
	}
      }
    }
    pin("w_data[0]") {
      direction : input;
      capacitance : 0.0057;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02219");
	}
	fall_constraint(scalar) {
          values("-0.12184");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
