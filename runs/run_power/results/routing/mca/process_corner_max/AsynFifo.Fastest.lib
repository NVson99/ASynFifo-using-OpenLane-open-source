      capacitance : 0.0013;
    }
    pin("r_data[3]") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("r_data[2]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0006;
    }
    }
    bus("w_data") {
