library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.98453,6.99374,7.01958,7.08615,7.28680,7.99506,10.54934");
	}
	rise_transition(template_1) {
          values("0.04125,0.04776,0.06866,0.13934,0.40694,1.40446,4.99929");
	}
	cell_fall(template_1) {
          values("6.35341,6.36020,6.38237,6.43832,6.59477,7.13037,9.06640");
	}
	fall_transition(template_1) {
          values("0.03460,0.03988,0.05721,0.10990,0.30124,1.02176,3.65168");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0036;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0056;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0049;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0717;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.54177");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.69293");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.36198");
	}
	fall_constraint(scalar) {
          values("-0.17911");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.55153");
	}
	fall_constraint(scalar) {
          values("1.19152");
	}
      }
    }
    bus("r_data") {
