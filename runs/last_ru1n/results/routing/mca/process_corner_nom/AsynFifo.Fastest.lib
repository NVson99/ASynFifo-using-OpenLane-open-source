          values("-0.03278");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.01635");
	}
	fall_constraint(scalar) {
          values("0.08673");
	}
      }
    }
    pin("w_data[0]") {
      direction : input;
      capacitance : 0.0058;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02481");
	}
	fall_constraint(scalar) {
          values("-0.03520");
	}
      }
      timing() {
        related_pin : "w_clk";
