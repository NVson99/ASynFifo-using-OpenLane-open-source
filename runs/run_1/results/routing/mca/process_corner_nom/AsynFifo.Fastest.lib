library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.98527,6.98886,6.99804,7.02082,7.08626,7.30182,8.01386");
	}
	rise_transition(template_1) {
          values("0.01869,0.02118,0.02859,0.05344,0.14448,0.45861,1.50695");
	}
	cell_fall(template_1) {
          values("6.35390,6.35690,6.36487,6.38350,6.42902,6.56436,7.01269");
	}
	fall_transition(template_1) {
          values("0.01559,0.01778,0.02359,0.03912,0.08889,0.26572,0.86355");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0036;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0056;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0050;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0718;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0060;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.52586");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.22073");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.05398");
	}
	fall_constraint(scalar) {
          values("-0.02576");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.38969");
	}
	fall_constraint(scalar) {
          values("0.29948");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
