      capacitance : 0.0009;
    }
    pin("r_data[3]") {
      direction : output;
      capacitance : 0.0015;
    }
    pin("r_data[2]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0007;
    }
    }
    bus("w_data") {
      bus_type : w_data;
      direction : input;
      capacitance : 0.0000;
    pin("w_data[7]") {
