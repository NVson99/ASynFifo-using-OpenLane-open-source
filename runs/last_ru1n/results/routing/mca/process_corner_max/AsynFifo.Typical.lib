	rise_constraint(scalar) {
          values("0.06864");
	}
	fall_constraint(scalar) {
          values("0.22829");
	}
      }
    }
    pin("w_data[4]") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.00699");
	}
	fall_constraint(scalar) {
          values("-0.12542");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.05546");
	}
	fall_constraint(scalar) {
          values("0.20675");
	}
      }
    }
    pin("w_data[3]") {
      direction : input;
