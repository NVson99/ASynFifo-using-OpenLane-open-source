	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.10008");
	}
	fall_constraint(scalar) {
          values("-0.02859");
	}
      }
    }
    pin("w_data[0]") {
      direction : input;
      capacitance : 0.0087;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.10155");
	}
	fall_constraint(scalar) {
