	}
      }
    }
    pin("w_data[4]") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.00840");
	}
	fall_constraint(scalar) {
          values("-0.04081");
	}
      }
      timing() {
        related_pin : "w_clk";
