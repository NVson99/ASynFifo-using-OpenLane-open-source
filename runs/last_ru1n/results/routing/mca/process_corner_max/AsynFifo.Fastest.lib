	rise_constraint(scalar) {
          values("0.02558");
	}
	fall_constraint(scalar) {
          values("0.09624");
	}
      }
    }
    pin("w_data[4]") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01326");
	}
	fall_constraint(scalar) {
          values("-0.03332");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.01647");
	}
	fall_constraint(scalar) {
          values("0.08353");
	}
      }
    }
    pin("w_data[3]") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.04482");
	}
	fall_constraint(scalar) {
          values("-0.00757");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.00165");
	}
	fall_constraint(scalar) {
          values("0.07075");
	}
      }
    }
    pin("w_data[2]") {
      direction : input;
      capacitance : 0.0038;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01364");
	}
	fall_constraint(scalar) {
          values("-0.03125");
	}
      }
      timing() {
        related_pin : "w_clk";
