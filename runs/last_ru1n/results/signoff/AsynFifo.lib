      capacitance : 0.0000;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0000;
    }
    }
    bus("w_data") {
