      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.03416");
	}
	fall_constraint(scalar) {
          values("-0.10159");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.03061");
	}
	fall_constraint(scalar) {
          values("0.20049");
	}
      }
    }
    pin("w_data[2]") {
      direction : input;
      capacitance : 0.0037;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.01271");
	}
	fall_constraint(scalar) {
          values("-0.13304");
	}
      }
      timing() {
        related_pin : "w_clk";
