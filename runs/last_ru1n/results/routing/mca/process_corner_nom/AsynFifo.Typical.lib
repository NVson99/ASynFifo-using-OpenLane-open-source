	rise_constraint(scalar) {
          values("0.07103");
	}
	fall_constraint(scalar) {
          values("0.23420");
	}
      }
    }
    pin("w_data[4]") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.01068");
	}
	fall_constraint(scalar) {
          values("-0.13472");
	}
      }
      timing() {
        related_pin : "w_clk";
