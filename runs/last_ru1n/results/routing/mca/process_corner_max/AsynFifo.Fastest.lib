	}
	fall_constraint(scalar) {
          values("-0.02757");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.01137");
	}
	fall_constraint(scalar) {
          values("0.07960");
	}
      }
    }
    pin("w_data[0]") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02844");
	}
	fall_constraint(scalar) {
          values("-0.03190");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
