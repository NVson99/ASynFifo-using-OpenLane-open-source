library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0018;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.00642,6.01035,6.02032,6.04402,6.10969,6.32488,7.03790");
	}
	rise_transition(template_1) {
          values("0.02105,0.02386,0.03135,0.05527,0.14487,0.45853,1.50432");
	}
	cell_fall(template_1) {
          values("5.24508,5.24809,5.25606,5.27472,5.32027,5.45564,5.90341");
	}
	fall_transition(template_1) {
          values("0.01550,0.01772,0.02343,0.03908,0.08880,0.26578,0.86364");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0034;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0039;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0027;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0285;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0039;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.44686");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.16416");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.14538");
	}
	fall_constraint(scalar) {
          values("-0.12686");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.51895");
	}
	fall_constraint(scalar) {
          values("0.43460");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
      capacitance : 0.0000;
    pin("r_data[7]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("r_data[6]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[5]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("r_data[4]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("r_data[3]") {
      direction : output;
      capacitance : 0.0017;
    }
    pin("r_data[2]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0008;
    }
    }
    bus("w_data") {
      bus_type : w_data;
      direction : input;
      capacitance : 0.0000;
    pin("w_data[7]") {
      direction : input;
      capacitance : 0.0033;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.03247");
	}
	fall_constraint(scalar) {
          values("-0.01949");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.02201");
	}
	fall_constraint(scalar) {
          values("0.09516");
	}
      }
    }
    pin("w_data[6]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02884");
	}
	fall_constraint(scalar) {
          values("-0.02247");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.00272");
	}
	fall_constraint(scalar) {
          values("0.07391");
	}
      }
    }
    pin("w_data[5]") {
      direction : input;
      capacitance : 0.0037;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01951");
	}
	fall_constraint(scalar) {
          values("-0.02912");
	}
      }
      timing() {
        related_pin : "w_clk";
