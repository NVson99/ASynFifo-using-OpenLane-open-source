library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("7.10352,7.10807,7.11981,7.14764,7.22091,7.44412,8.15560");
	}
	rise_transition(template_1) {
          values("0.02480,0.02796,0.03738,0.06600,0.16210,0.48202,1.50540");
	}
	cell_fall(template_1) {
          values("6.18560,6.18960,6.20007,6.22316,6.27714,6.42965,6.91019");
	}
	fall_transition(template_1) {
          values("0.02087,0.02334,0.03063,0.05000,0.10892,0.30678,0.94813");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0037;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0064;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0058;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0767;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0060;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.81607");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.29915");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0055;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.10191");
	}
	fall_constraint(scalar) {
          values("-0.00444");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.65861");
	}
	fall_constraint(scalar) {
          values("0.45896");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
      capacitance : 0.0000;
    pin("r_data[7]") {
      direction : output;
      capacitance : 0.0010;
    }
