library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.84231,6.84583,6.85482,6.87739,6.94278,7.15842,7.87024");
	}
	rise_transition(template_1) {
          values("0.01815,0.02056,0.02795,0.05302,0.14440,0.45863,1.50755");
	}
	cell_fall(template_1) {
          values("5.95631,5.95932,5.96729,5.98593,6.03146,6.16681,6.61494");
	}
	fall_transition(template_1) {
          values("0.01555,0.01776,0.02353,0.03911,0.08886,0.26574,0.86358");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0036;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0063;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0057;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0668;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.49968");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17869");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0055;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.04113");
	}
	fall_constraint(scalar) {
          values("-0.00042");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.37933");
	}
	fall_constraint(scalar) {
          values("0.27941");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
      capacitance : 0.0000;
    pin("r_data[7]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("r_data[6]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[5]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("r_data[4]") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("r_data[3]") {
      direction : output;
      capacitance : 0.0015;
    }
    pin("r_data[2]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0006;
    }
    }
    bus("w_data") {
      bus_type : w_data;
      direction : input;
      capacitance : 0.0000;
    pin("w_data[7]") {
      direction : input;
      capacitance : 0.0078;
