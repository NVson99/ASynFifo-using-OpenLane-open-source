          values("0.00267");
	}
	fall_constraint(scalar) {
          values("0.07650");
	}
      }
    }
    pin("w_data[2]") {
      direction : input;
      capacitance : 0.0037;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.00709");
	}
	fall_constraint(scalar) {
