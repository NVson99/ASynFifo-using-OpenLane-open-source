library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0012;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("7.10307,7.11229,7.13817,7.20476,7.40541,8.11373,10.66803");
	}
	rise_transition(template_1) {
          values("0.04137,0.04788,0.06877,0.13941,0.40695,1.40449,4.99926");
	}
	cell_fall(template_1) {
          values("6.18536,6.19217,6.21435,6.27031,6.42677,6.96235,8.89836");
	}
	fall_transition(template_1) {
          values("0.03466,0.03993,0.05726,0.10993,0.30125,1.02182,3.65159");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0037;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0064;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0057;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0767;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0060;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.55120");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.61984");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0055;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.29720");
	}
	fall_constraint(scalar) {
          values("-0.10758");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.48756");
	}
	fall_constraint(scalar) {
          values("1.08806");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
