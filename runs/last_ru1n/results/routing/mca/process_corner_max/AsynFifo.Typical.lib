	}
	fall_constraint(scalar) {
          values("-0.11503");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.04974");
	}
	fall_constraint(scalar) {
          values("0.20815");
	}
      }
    }
    pin("w_data[0]") {
      direction : input;
      capacitance : 0.0058;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02540");
	}
	fall_constraint(scalar) {
          values("-0.11580");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
