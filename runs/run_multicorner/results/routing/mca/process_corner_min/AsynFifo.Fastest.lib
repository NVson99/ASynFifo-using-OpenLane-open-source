	rise_constraint(scalar) {
          values("-0.09742");
	}
	fall_constraint(scalar) {
          values("-0.03533");
	}
      }
    }
    pin("w_data[5]") {
      direction : input;
      capacitance : 0.0083;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.13112");
	}
	fall_constraint(scalar) {
