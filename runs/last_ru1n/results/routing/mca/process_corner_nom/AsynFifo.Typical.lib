library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0017;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("5.92373,5.92860,5.94096,5.96935,6.04290,6.26595,6.98151");
	}
	rise_transition(template_1) {
          values("0.02782,0.03071,0.03983,0.06746,0.16229,0.48216,1.50601");
	}
	cell_fall(template_1) {
          values("5.17698,5.18093,5.19122,5.21433,5.26836,5.42078,5.90106");
	}
	fall_transition(template_1) {
          values("0.02072,0.02327,0.03049,0.04990,0.10896,0.30672,0.94762");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0032;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0026;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0266;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0037;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.66455");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.26428");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0031;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.28012");
	}
	fall_constraint(scalar) {
          values("-0.24066");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.88632");
	}
	fall_constraint(scalar) {
          values("0.69707");
	}
      }
    }
    bus("r_data") {
      bus_type : r_data;
      direction : output;
      capacitance : 0.0000;
    pin("r_data[7]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("r_data[6]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("r_data[5]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("r_data[4]") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("r_data[3]") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("r_data[2]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0008;
    }
    }
    bus("w_data") {
      bus_type : w_data;
      direction : input;
      capacitance : 0.0000;
    pin("w_data[7]") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01652");
	}
	fall_constraint(scalar) {
          values("-0.11885");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.05897");
	}
	fall_constraint(scalar) {
          values("0.22810");
	}
      }
    }
    pin("w_data[6]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01215");
	}
	fall_constraint(scalar) {
          values("-0.12164");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.03635");
	}
	fall_constraint(scalar) {
          values("0.19992");
	}
      }
    }
    pin("w_data[5]") {
      direction : input;
      capacitance : 0.0036;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.00150");
	}
	fall_constraint(scalar) {
          values("-0.12948");
	}
      }
      timing() {
        related_pin : "w_clk";
