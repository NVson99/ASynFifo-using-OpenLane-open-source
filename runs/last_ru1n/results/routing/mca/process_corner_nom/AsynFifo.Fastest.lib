	rise_constraint(scalar) {
          values("0.00512");
	}
	fall_constraint(scalar) {
          values("0.07647");
	}
      }
    }
    pin("w_data[5]") {
      direction : input;
      capacitance : 0.0037;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01329");
	}
	fall_constraint(scalar) {
