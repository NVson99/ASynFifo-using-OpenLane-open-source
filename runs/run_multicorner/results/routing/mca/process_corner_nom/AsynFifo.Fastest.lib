	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.10886");
	}
	fall_constraint(scalar) {
          values("-0.03531");
	}
      }
    }
    pin("w_data[0]") {
      direction : input;
      capacitance : 0.0087;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
