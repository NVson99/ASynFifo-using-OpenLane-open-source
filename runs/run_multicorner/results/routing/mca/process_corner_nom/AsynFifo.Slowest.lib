      capacitance : 0.0005;
    }
    pin("r_data[1]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("r_data[0]") {
      direction : output;
      capacitance : 0.0006;
    }
    }
    bus("w_data") {
