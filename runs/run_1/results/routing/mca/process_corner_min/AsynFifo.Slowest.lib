library (AsynFifo) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }
  type ("r_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("w_data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("AsynFifo") {
    pin("empty") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("full") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "w_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("6.82515,6.83428,6.85995,6.92639,7.12704,7.83501,10.38922");
	}
	rise_transition(template_1) {
          values("0.04060,0.04712,0.06806,0.13898,0.40694,1.40436,4.99944");
	}
	cell_fall(template_1) {
          values("6.22530,6.23219,6.25436,6.31029,6.46672,7.00239,8.93716");
	}
	fall_transition(template_1) {
          values("0.03450,0.03979,0.05712,0.10984,0.30121,1.02157,3.65050");
	}
      }
    }
    pin("r_clk") {
      direction : input;
      capacitance : 0.0035;
    }
    pin("r_rst_n") {
      direction : input;
      capacitance : 0.0055;
    }
    pin("rd") {
      direction : input;
      capacitance : 0.0049;
    }
    pin("w_clk") {
      direction : input;
      capacitance : 0.0670;
    }
    pin("w_rst_n") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.50354");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.68140");
	}
      }
    }
    pin("wr") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "w_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.37559");
	}
	fall_constraint(scalar) {
          values("-0.20341");
	}
      }
      timing() {
        related_pin : "w_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.55879");
	}
	fall_constraint(scalar) {
          values("1.20291");
	}
      }
    }
